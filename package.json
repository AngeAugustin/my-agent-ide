{
  "name": "my-agent-ide",
  "productName": "My Agent IDE",
  "version": "0.1.0",
  "description": "IDE de bureau propulsé par l'IA, où vous apportez vos propres clés API.",
  "main": "./out/main/index.js",
  "author": "Ange Augustin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --publish never",
    "icon": "node scripts/make-icon.mjs",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "node-pty": "^1.1.0",
    "openai": "^7.28.0",
    "typescript": "~5.9",
    "typescript-language-server": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "homepage": "https://github.com/AngeAugustin/my-agent-ide",
  "desktopName": "my-agent-ide.desktop"
}
