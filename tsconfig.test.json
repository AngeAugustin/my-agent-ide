{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["vitest.config.ts", "tests/**/*", "src/main/search.ts", "src/main/walk.ts", "src/shared/**/*", "src/renderer/src/lib/fuzzy.ts", "src/renderer/src/lib/keybindings.ts", "src/renderer/src/lib/paths.ts"]
}
